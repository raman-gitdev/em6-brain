# Copy this file to .env and fill in the values. .env is never committed to Git.

# Password for the brain's own Postgres (logs and conversations). Pick anything strong.
POSTGRES_PASSWORD=rama@0827

# Where the brain (Ollama) is. On this PC the default works.
# When the brain moves to a server, change only this line.
BRAIN_URL=http://host.docker.internal:11434
BRAIN_MODEL=qwen2.5:7b

# How much text the brain can hold at once (tokens). More = more RAM.
BRAIN_NUM_CTX=8192
